{
  "name": "mtg-battlefield-app",
  "productName": "MTG Battlefield",
  "description": "A local 1v1 Commander tabletop where an agent plays the other seat",
  "author": "Artem Litchmanov",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "bun ./build.mjs",
    "dist:mac": "bun ./build.mjs --target=mac-arm64",
    "dist:win": "bun ./build.mjs --target=win-x64",
    "dist:linux": "bun ./build.mjs --target=linux-x64",
    "icons": "node make-icons.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
