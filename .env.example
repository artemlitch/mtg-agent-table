# Copy to .env (gitignored) and fill in what you need. Bun loads .env from the
# repo root at boot, so `bun run server/index.ts` picks these up on its own.
#
# NOTHING HERE IS REQUIRED. Every secret can be typed into the app instead —
# the table asks for a brain on first run, the deck studio asks for Archidekt.
# A .env is for people who would rather keep it in a file.

# ── The agent's brain ───────────────────────────────────────────────────────

# DeepSeek API key. The Chat tab asks for this if it is missing, and stores it
# 0600 in the app data dir instead. Billed per token; a game costs cents.
# DEEPSEEK_API_KEY=sk-...

# There is deliberately NO ANTHROPIC_API_KEY here. Claude plays on your Claude
# Code subscription (`claude` CLI) or it does not play — see server/agent.ts.

# Point a provider somewhere else: a local proxy, a recording, a fake in a test.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# The Claude Code binary, if it is not on PATH.
# CLAUDE_BIN=/opt/homebrew/bin/claude

# Force a transport instead of letting the model decide: "cli", "api", "none".
# AGENT_TRANSPORT=cli

# ── Deck studio (bun run server/studio-server.ts) ───────────────────────────

# Archidekt has no API tokens, so writing a deck costs the account password.
# Leave these out and the studio page asks for them, storing them 0600 in the
# app data dir. Set them and the sign-out button goes away — the page cannot
# edit a file it did not write.
# ARCHIDEKT_USER=
# ARCHIDEKT_PASS=

# ── Where things live ───────────────────────────────────────────────────────

# Ports. The table serves the built UI on 4780; the studio is its own server.
# PORT=4780
# STUDIO_PORT=4781

# Games, keys and the live state file default to the OS application-data dir
# (~/Library/Application Support/MTG Battlefield on macOS). Point them at a
# scratch dir to play with a throwaway table.
# DATA_DIR=/tmp/mtg-table
# STATE_FILE=/tmp/mtg-table/state.json
# GAMES_DIR=/tmp/mtg-table/games

# Run the table with nobody in the other seat — useful for replaying a game
# into a fresh server without the agent acting on it.
# AGENT_DISABLED=1
